# SARAS AI backend configuration.
# Copy to backend/.env (git-ignored) and edit. Every value below is the built-in default
# from app/config.py, so an empty .env behaves exactly like this file. Real environment
# variables override .env. All names take the SARAS_ prefix.
#
# Defaults are the low-resource profile (PRD 18.6): 4 GB laptop, SQLite, one in-process
# worker thread, no ML models required.

# ---------------------------------------------------------------- runtime
# dev | test | prod.  In "prod" the app refuses to start with the development JWT secret.
SARAS_ENV=dev
# Log level for the app: DEBUG | INFO | WARNING | ERROR
SARAS_LOG_LEVEL=INFO

# ---------------------------------------------------------------- storage
# Default: SQLite file at backend/data/saras.db (relative paths resolve from the folder
# the server is started in, so prefer absolute paths). Extended profile (Docker Compose):
#   SARAS_DATABASE_URL=postgresql+psycopg://saras:<password>@db:5432/saras
# SARAS_DATABASE_URL=sqlite:///C:/path/to/SARAS.AI/backend/data/saras.db
# Uploaded PDFs and rendered page images. Default: backend/data/storage
# SARAS_STORAGE_DIR=C:/path/to/SARAS.AI/backend/data/storage

# ---------------------------------------------------------------- auth
# REQUIRED outside dev: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in dev to use the built-in insecure development secret (a warning is logged).
# SARAS_JWT_SECRET=
SARAS_ACCESS_TOKEN_MINUTES=15
SARAS_REFRESH_TOKEN_DAYS=7
# Login lock-out: after this many failed attempts, logins are refused (429) for N minutes.
SARAS_LOGIN_MAX_FAILURES=5
SARAS_LOGIN_LOCK_MINUTES=5

# ---------------------------------------------------------------- uploads (PRD 6.2)
SARAS_MAX_UPLOAD_MB=20
SARAS_MAX_PAGES=50

# ---------------------------------------------------------------- pipeline
# Page render resolution. 150 DPI keeps memory low on the 4 GB laptop.
SARAS_RENDER_DPI=150
# OCR engine: auto | textlayer | trocr
#   auto      PDF text layer when the page has one, else TrOCR if installed, else no text
#             (the answer is flagged needs_transcription for the teacher to type in)
#   textlayer PDF text layer only
#   trocr     TrOCR handwriting model only (needs requirements-ml.txt, >= 8 GB RAM)
SARAS_OCR_ENGINE=auto
SARAS_TROCR_MODEL=microsoft/trocr-small-handwritten
# Grader: auto | lexical | sbert | nli
#   auto      sbert if sentence-transformers is installed, else lexical
#   lexical   dependency-free, OCR-noise-tolerant scorer (always available)
#   sbert     Sentence-BERT cosine similarity (needs requirements-ml.txt)
#   nli       DeBERTa-v3 NLI cross-encoder (needs requirements-ml.txt)
SARAS_GRADER=auto
SARAS_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
SARAS_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

# ---------------------------------------------------------------- grading thresholds (PRD 12.11)
# Tune on validation data and freeze before the test set is used.
# Key point is "matched" at entailment >= TAU, "partial" (half weight) at >= TAU_LOW.
SARAS_TAU=0.6
SARAS_TAU_LOW=0.4
# Contradiction probability at which a key point is marked contradicted (0 marks).
SARAS_CONTRADICTION_THRESHOLD=0.5
# Combined confidence needed to auto-accept an answer; below it the answer goes to review.
SARAS_AUTO_ACCEPT_THRESHOLD=0.80
# true: uncertain answers wait in needs_review and block approval until a teacher checks them.
# false: AI marks go straight to the results (review stays optional before final approval);
# only answers nobody could mark (unread page, no AI reply) still wait for a teacher.
SARAS_REVIEW_REQUIRED=true
# OCR confidence below which an answer gets the low_ocr_confidence flag.
SARAS_LOW_OCR_CONFIDENCE=0.5
# Temperature scaling of the combined confidence (1.0 = identity; fit on validation data).
SARAS_CALIBRATION_TEMPERATURE=1.0

# ---------------------------------------------------------------- background worker
# In-process worker thread that drains the database job table. Set false to run an
# API-only process (jobs then wait until a process with the worker enabled picks them up).
SARAS_WORKER_ENABLED=true
SARAS_WORKER_POLL_SECONDS=1.0
SARAS_JOB_MAX_ATTEMPTS=3
# A running job with no heartbeat for this long is treated as crashed and re-queued.
SARAS_JOB_STALE_SECONDS=300

# ---------------------------------------------------------------- API
# JSON list of browser origins allowed by CORS (the Vite dev server). Not needed when
# FastAPI serves the built frontend itself (same origin).
SARAS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SARAS_RATE_LIMIT_ENABLED=true
# Requests per minute per client, and uploads per minute per client.
SARAS_RATE_LIMIT_PER_MINUTE=100
SARAS_UPLOAD_RATE_PER_MINUTE=10
# Built SPA served at "/" when the folder exists. Default: frontend/dist next to backend/
# SARAS_FRONTEND_DIST=C:/path/to/SARAS.AI/frontend/dist

# ---------------------------------------------------------------- AI (LLM) grading (PRD 13.5)
# Optional. The offline checker always runs; AI marking is layered on top and falls back to
# the offline checker whenever no provider answers. Nothing is sent to any provider unless
# SARAS_AI_CONSENT=true. Answers are anonymised first (names, roll numbers, e-mails, phone
# numbers and URLs removed). Keys live ONLY in backend/.env: never commit or log them.
# off | ensemble   (ensemble = AI and offline checker both grade; disagreements go to review)
SARAS_AI_GRADING=off
SARAS_AI_CONSENT=false
# Gemini's free tier may use data for training and human review: separate consent.
SARAS_GEMINI_CONSENT=false
# Groq (groq.com; does not train on customer data) — main AI marker.
# SARAS_GROQ_API_KEY=<your-groq-key>
# Google AI Studio — backup marker and (later) handwriting reading.
# SARAS_GEMINI_API_KEY=<your-gemini-key>
# Optional extra providers.
# SARAS_OPENROUTER_API_KEY=<your-openrouter-key>
# SARAS_OLLAMA_BASE_URL=http://localhost:11434
# JSON list of "provider:model", tried in order (providers: groq | gemini | openrouter | ollama).
SARAS_AI_GRADING_PROVIDERS=["groq:openai/gpt-oss-120b","groq:openai/gpt-oss-20b","gemini:gemini-3.5-flash-lite","gemini:gemini-3.1-flash-lite","gemini:gemini-flash-lite-latest"]
# Question-only rubrics (no model answer, no key points): the AI marker above reads each answer
# and gives the marks itself, one request per sheet.
# Reading scanned / handwritten pages (no PDF text layer) with a vision model, tried in order.
# Needs SARAS_AI_CONSENT; Gemini also needs SARAS_GEMINI_CONSENT (the page image is sent).
SARAS_AI_OCR=true
SARAS_AI_OCR_PROVIDERS=["gemini:gemini-flash-lite-latest","groq:qwen/qwen3.8-27b","gemini:gemini-3.5-flash-lite","gemini:gemini-3.1-flash-lite","gemini:gemini-flash-latest"]
SARAS_AI_TIMEOUT_SECONDS=30
# Retries per provider on 429 / 5xx / timeouts / invalid output, then the next provider.
SARAS_AI_MAX_RETRIES=2
# Client-side budgets per model, kept below the free tiers (Groq ~8K tokens/min, ~200K/day;
# Gemini Flash-Lite ~10 requests/min). Daily budgets are a rolling 24 hours.
SARAS_GROQ_TOKENS_PER_MINUTE=6000
SARAS_GROQ_TOKENS_PER_DAY=170000
SARAS_GEMINI_REQUESTS_PER_MINUTE=10
SARAS_GEMINI_REQUESTS_PER_DAY=400
# A sheet is one request unless its prompt is larger than this (estimated at 4 chars/token).
SARAS_AI_MAX_INPUT_TOKENS_PER_CALL=3500
# OpenRouter forwards prompts to upstream providers whose free endpoints may log or train
# on them: it needs its own consent on top of SARAS_AI_CONSENT (requests also ask OpenRouter
# for data_collection=deny). SARAS_OLLAMA_BASE_URL is used only when it points at this
# machine or the local network (localhost, a private IP, a single-label or .local name).
SARAS_OPENROUTER_CONSENT=false
# Wall-clock limit for one AI request (all providers, retries and backoff). Past it the
# remaining providers are skipped and the offline checker decides. 0 = no limit.
SARAS_AI_CALL_DEADLINE_SECONDS=60
# Anonymisation removes e-mails, URLs, phone numbers, IDs (labelled, or shaped like roll
# numbers) and names written after a label ("Name:", "my name is", "I am"). A name written
# with no label cannot be detected offline and is NOT removed.
